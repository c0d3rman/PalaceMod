      "logic": {
        "vars": {
          "flipped": false
        },
        "hud": [
          {
            "id": "phase",
            "text": "{$flipped ? (isDay ? 'FLIPPED: build under attack!' : 'FLIPPED: raid the enemy camps') : (isDay ? 'Day' : 'Night')}"
          }
        ],
        "rules": [
          {
            "id": "flip-day",
            "when": "day",
            "if": "night == 2",
            "do": [
              {
                "do": "setVar",
                "name": "flipped",
                "value": true
              },
              {
                "do": "message",
                "text": "The cycle is reversed! They attack while you build.",
                "kind": "warn",
                "seconds": 6
              }
            ]
          },
          {
            "id": "day-assault",
            "when": {
              "on": "every",
              "seconds": 12,
              "during": "day"
            },
            "if": "$flipped",
            "do": [
              {
                "do": "spawn",
                "entity": "day-raider",
                "count": 2,
                "at": "spawnLine('south')",
                "spread": 3,
                "team": "enemy"
              }
            ]
          },
          {
            "id": "raid-night",
            "when": "nightStart",
            "if": "$flipped",
            "do": [
              {
                "do": "spawn",
                "entity": "enemy-camp",
                "at": "vec(50, -70)",
                "team": "enemy"
              },
              {
                "do": "spawn",
                "entity": "enemy-camp",
                "at": "vec(-45, -70)",
                "team": "enemy"
              },
              {
                "do": "message",
                "text": "Night raid: destroy the enemy camps",
                "kind": "info"
              }
            ]
          },
          {
            "id": "unflip",
            "when": "dawn",
            "if": "$flipped and night >= 2",
            "do": [
              {
                "do": "setVar",
                "name": "flipped",
                "value": false
              },
              {
                "do": "forEach",
                "in": "all('enemy and unit')",
                "actions": [
                  {
                    "do": "destroy",
                    "target": "it",
                    "silent": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
