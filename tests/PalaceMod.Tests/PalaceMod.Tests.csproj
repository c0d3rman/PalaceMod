<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the game-independent parts of PalaceMod (the Builder's share codec and .tfpack handling).
    A plain console runner, so it needs no test framework packages:

        dotnet run (project: tests/PalaceMod.Tests)

    Needs `python3 scripts/dev.py setup` first (for lib/Newtonsoft.Json.dll and lib/Assembly-CSharp.dll).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <RootNamespace>PalaceMod.Tests</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/DesignPack.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/UnitDef.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/WaveSetDef.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/LevelDef.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/LevelPin.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/ContentRef.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/Validation.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/Logic/*.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/PackSerializer.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/LibraryStore.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/Requirements.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Studio/Requirements/ChainPreset.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Studio/StudioMath.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/Descriptions.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Contracts/Contracts.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Sharing/ShareCodec.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Studio/Play/TestPacks.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Sharing/PackArchive.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Assets/GltfCheck.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Assets/Loaders.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Library/AssetFileReader.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Library/SceneryCatalog.cs" />
    <Compile Include="../../src/PalaceMod/Features/Economy/EconomyModel.cs" />
    <Compile Include="../../src/PalaceMod/Features/Economy/PlannerStore.cs" />
    <Compile Include="../../src/PalaceMod/Features/Economy/PlannerReach.cs" />
    <Compile Include="../../src/PalaceMod/Core/UI/NumberMath.cs" />
    <Compile Include="../../src/PalaceMod/Core/UI/ColorMath.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Model/TerrainDef.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Level/GroundCodec.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Level/PaintOutline.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Level/GroundPalette.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Studio/Terrain/TerrainBrushes.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Level/UnitSpread.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Studio/Enemies/EnemyMath.cs" />
    <Compile Include="../../src/PalaceMod/Features/Builder/Logic/Bodies/Stats/StatMath.cs" />
    <!-- Behaviour engine core (L1): the pure files of Logic/Runtime; the Unity side is excluded. -->
    <Compile Include="../../src/PalaceMod/Features/Builder/Logic/Runtime/*.cs"
             Exclude="../../src/PalaceMod/Features/Builder/Logic/Runtime/LogicGame.cs;../../src/PalaceMod/Features/Builder/Logic/Runtime/LogicGameWorld.cs;../../src/PalaceMod/Features/Builder/Logic/Runtime/BuilderEntity.cs;../../src/PalaceMod/Features/Builder/Logic/Runtime/LogicManager*.cs;../../src/PalaceMod/Features/Builder/Logic/Runtime/Game*.cs" />
    <EmbeddedResource Include="../../src/PalaceMod/Assets/builder-sample.json" LogicalName="builder-sample.json" />
    <EmbeddedResource Include="../../src/PalaceMod/Assets/builder-presets.json" LogicalName="builder-presets.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.50" IncludeAssets="compile" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../lib/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>../../lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
